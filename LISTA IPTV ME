let selectedChannel = null;
let previousPage = "tv";

function showPage(page){
 if(page!=="tv"&&page!=="guide")return;
 document.getElementById("tvPage").classList.toggle("active",page==="tv");
 document.getElementById("guidePage").classList.toggle("active",page==="guide");
 document.getElementById("guideButton").classList.toggle("active",page==="guide");
 document.getElementById("screen").style.display="none";
 document.getElementById("frame").src="";
 selectedChannel=null;
 previousPage=page;
 window.scrollTo({top:0,behavior:"instant"});
}

function makeChannelCard(channel){
 const card=document.createElement("button");
 card.type="button";card.className="channel";
 card.style.setProperty("--accent",channel.color);
 card.setAttribute("aria-label","Abrir "+channel.name);

 const box=document.createElement("div");box.className="logo-box";
 const fallback=document.createElement("div");
 fallback.className="logo-fallback";fallback.textContent=channel.icon;

 if(channel.logo){
  const img=document.createElement("img");
  img.src=channel.logo;img.alt="Logo de "+channel.name;img.loading="lazy";
  img.onerror=()=>{img.style.display="none";if(!box.contains(fallback))box.appendChild(fallback);};
  box.appendChild(img);
 }else box.appendChild(fallback);

 const title=document.createElement("h3");title.textContent=channel.name;
 const subtitle=document.createElement("p");subtitle.textContent=channel.external?"Abrir agenda":"Ver canal";
 card.append(box,title,subtitle);
 card.addEventListener("click",()=>openChannel(channel));
 return card;
}

function renderChannels(containerId,emptyId,searchId,categoryId){
 const grid=document.getElementById(containerId);
 const empty=document.getElementById(emptyId);
 const search=document.getElementById(searchId);
 const category=document.getElementById(categoryId);

 function update(){
  const query=search.value.trim().toLocaleLowerCase("es");
  const cat=category.value;
  const filtered=channels.filter(c=>
   c.name.toLocaleLowerCase("es").includes(query)&&
   (cat==="all"||c.category===cat)
  );
  grid.replaceChildren();
  filtered.forEach(c=>grid.appendChild(makeChannelCard(c)));
  empty.style.display=filtered.length?"none":"block";
 }
 search.addEventListener("input",update);
 category.addEventListener("change",update);
 update();
}

function openChannel(channel){
 if(channel.external){window.open(channel.url,"_blank","noopener,noreferrer");return;}
 selectedChannel=channel;
 document.getElementById("screen").style.display="block";
 document.getElementById("confirmation").style.display="block";
 document.getElementById("player").style.display="none";
 document.getElementById("channelName").textContent=channel.name;

 const img=document.getElementById("selectedLogo");
 img.onerror=()=>{img.style.display="none";};
 img.style.display=channel.logo?"block":"none";
 img.src=channel.logo||"";
 window.scrollTo({top:0,behavior:"instant"});
}

function startChannel(){
 if(!selectedChannel)return;
 document.getElementById("confirmation").style.display="none";
 document.getElementById("player").style.display="block";
 document.getElementById("playerTitle").textContent=selectedChannel.name;
 document.getElementById("frame").src=selectedChannel.url;
}

function goBack(){
 document.getElementById("frame").src="";
 document.getElementById("screen").style.display="none";
 document.getElementById("confirmation").style.display="block";
 document.getElementById("player").style.display="none";
 selectedChannel=null;
}

renderChannels("tvChannels","tvEmpty","tvSearch","tvCategory");
renderChannels("guideChannels","guideEmpty","guideSearch","guideCategory");
</script>
